# --- Telegram ---
# Токен бота от @BotFather
BOT_TOKEN=123456789:replace-with-your-bot-token
# Имя бота без @
BOT_USERNAME=nomerny_fart_bot
# Короткое имя Mini App из BotFather (/newapp) — ссылки вида t.me/<bot>/<app>
MINI_APP_SHORT_NAME=app
# Telegram ID администраторов через запятую
ADMIN_TELEGRAM_IDS=
# Общий секрет для запросов бот → API (длинная случайная строка)
INTERNAL_API_TOKEN=change-me-to-a-long-random-string-0123456789

# --- Postgres / Redis ---
POSTGRES_USER=nomer
POSTGRES_PASSWORD=nomer
POSTGRES_DB=nomer
DATABASE_URL=postgresql://nomer:nomer@localhost:5432/nomer
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=3000
# Через запятую; * — любой источник
CORS_ORIGIN=*
# Вход без Telegram (Authorization: dev <telegramId>) — только для локальной отладки
DEV_AUTH=false

# --- Продакшен (docker-compose.prod.yml) ---
# Домен, на который Caddy получит HTTPS-сертификат (A-запись должна вести на сервер)
APP_DOMAIN=

# --- Бот ---
# HTTPS-адрес Mini App (кнопка меню и /start). Локально — адрес туннеля на порт 8081 (или 5173 в dev)
WEB_APP_URL=https://your-tunnel.example.com
# Публичный HTTPS-адрес API (для PNG-карточек при шаринге). Если Mini App и API за одним
# nginx (docker compose, сервис web) — тот же адрес, что WEB_APP_URL. Пусто — шаринг текстом
PUBLIC_API_URL=
# Webhook вместо long polling (для продакшена): URL должен вести на <бот>:8080/telegram
BOT_WEBHOOK_URL=
BOT_WEBHOOK_SECRET=

# --- Mini App (только для разработки вне Telegram, нужен DEV_AUTH=true) ---
VITE_DEV_TELEGRAM_ID=

# --- Сиды (npm run db:seed): создать своего игрока с коллекцией ---
SEED_TELEGRAM_ID=

# --- Тесты API (npm run test:int -w @nomer/api) ---
TEST_DATABASE_URL=postgresql://nomer:nomer@localhost:5432/nomer_test
TEST_REDIS_URL=redis://localhost:6379/1
